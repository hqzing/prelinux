@@ -0,0 +1,24 @@
+/* PreLinux id state.  Replaces the wrapper
+   generated from the syscalls.list (generated wrappers cannot carry
+   per-process state).  Instances pretend to be a machine of their own:
+   IDs start at root and privilege "drops" and "regains" just update the
+   per-process state, so verification reads (apt's DropPrivileges) stay
+   consistent.  The kernel credentials never change.  Without -DPRELINUX
+   this compiles to the same behavior as the generated wrapper.  */
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+#include <grp.h>
+#include <sysdep.h>
+#include <prelinux.h>
+
+uid_t
+__getuid (void)
+{
+#ifdef PRELINUX
+  return __prelinux_cred_ids[PRELINUX_RUID];
+#else
+  return INTERNAL_SYSCALL_CALL (getuid);
+#endif
+}
+weak_alias (__getuid, getuid)
