diff --git a/sysdeps/unix/sysv/linux/chdir.c b/sysdeps/unix/sysv/linux/chdir.c
new file mode 100644
index 00000000..b7ef6667
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/chdir.c
@@ -0,0 +1,15 @@
+/* Change the current working directory.  PreLinux version: replaces the
+   wrapper generated from sysdeps/unix/syscalls.list (generated wrappers
+   cannot be patched).  Without -DPRELINUX this compiles to the same
+   behavior as the generated wrapper.  */
+#include <unistd.h>
+#include <sysdep.h>
+#include <prelinux.h>
+
+int
+__chdir (const char *path)
+{
+  PRELINUX_TRANSLATE (path);
+  return INLINE_SYSCALL_CALL (chdir, path);
+}
+weak_alias (__chdir, chdir)
diff --git a/sysdeps/unix/sysv/linux/chroot.c b/sysdeps/unix/sysv/linux/chroot.c
new file mode 100644
index 00000000..1d6e7081
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/chroot.c
@@ -0,0 +1,14 @@
+/* Change the root directory.  PreLinux version: replaces the wrapper
+   generated from sysdeps/unix/syscalls.list.  The path is translated
+   and then passed through to the kernel as-is: no privileges are
+   faked, a non-root caller still gets EPERM .  */
+#include <unistd.h>
+#include <sysdep.h>
+#include <prelinux.h>
+
+int
+chroot (const char *path)
+{
+  PRELINUX_TRANSLATE (path);
+  return INLINE_SYSCALL_CALL (chroot, path);
+}
