 #ifdef __NR_mkdir
   return INLINE_SYSCALL_CALL (mkdir,  path, mode);
 #else
diff --git a/sysdeps/unix/sysv/linux/mkdirat.c b/sysdeps/unix/sysv/linux/mkdirat.c
new file mode 100644
index 00000000..3c80a57f
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/mkdirat.c
@@ -0,0 +1,13 @@
+/* Create a directory, relative to a directory.  PreLinux version:
+   replaces the wrapper generated from syscalls.list.  */
+#include <sys/stat.h>
+#include <sysdep.h>
+#include <prelinux.h>
+
+int
+__mkdirat (int fd, const char *path, mode_t mode)
+{
+  PRELINUX_TRANSLATE (path);
+  return INLINE_SYSCALL_CALL (mkdirat, fd, path, mode);
+}
+weak_alias (__mkdirat, mkdirat)
