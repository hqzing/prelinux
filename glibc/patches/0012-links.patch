diff --git a/sysdeps/unix/sysv/linux/readlinkat.c b/sysdeps/unix/sysv/linux/readlinkat.c
new file mode 100644
index 00000000..c99d5894
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/readlinkat.c
@@ -0,0 +1,16 @@
+/* Read a symlink, relative to a directory.  PreLinux version: replaces
+   the wrapper generated from syscalls.list (generated wrappers cannot
+   be patched).  Note: <unistd.h> declares readlinkat via hidden_proto,
+   so in this TU the function compiles as hidden __GI_readlinkat and
+   libc_hidden_def publishes the public alias.  */
+#include <unistd.h>
+#include <sysdep.h>
+#include <prelinux.h>
+
+ssize_t
+readlinkat (int fd, const char *path, char *buf, size_t len)
+{
+  PRELINUX_TRANSLATE (path);
+  return INLINE_SYSCALL_CALL (readlinkat, fd, path, buf, len);
+}
+libc_hidden_def (readlinkat)
