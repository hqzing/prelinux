@@ -0,0 +1,13 @@
+/* Remove a file or directory, relative to a directory.  PreLinux
+   version: replaces the wrapper generated from syscalls.list.  */
+#include <unistd.h>
+#include <sysdep.h>
+#include <prelinux.h>
+
+int
+__unlinkat (int fd, const char *name, int flag)
+{
+  PRELINUX_TRANSLATE (name);
+  return INLINE_SYSCALL_CALL (unlinkat, fd, name, flag);
+}
+weak_alias (__unlinkat, unlinkat)
