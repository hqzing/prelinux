index 00000000..10b54fc2
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/linkat.c
@@ -0,0 +1,13 @@
+/* Make a link, relative to directories.  PreLinux version: replaces the
+   wrapper generated from syscalls.list.  */
+#include <unistd.h>
+#include <sysdep.h>
+#include <prelinux.h>
+
+int
+linkat (int fromfd, const char *from, int tofd, const char *to, int flags)
+{
+  PRELINUX_TRANSLATE (from);
+  PRELINUX_TRANSLATE (to);
+  return INLINE_SYSCALL_CALL (linkat, fromfd, from, tofd, to, flags);
+}
