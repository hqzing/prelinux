diff --git a/sysdeps/unix/sysv/linux/symlinkat.c b/sysdeps/unix/sysv/linux/symlinkat.c
new file mode 100644
index 00000000..80aa8f1a
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/symlinkat.c
@@ -0,0 +1,15 @@
+/* Make a symlink, relative to a directory.  PreLinux version: replaces
+   the wrapper generated from syscalls.list.  An absolute link target is
+   translated too, so links stay self-consistent inside the instance.  */
+#include <unistd.h>
+#include <sysdep.h>
+#include <prelinux.h>
+
+int
+__symlinkat (const char *from, int fd, const char *to)
+{
+  PRELINUX_TRANSLATE (from);
+  PRELINUX_TRANSLATE (to);
+  return INLINE_SYSCALL_CALL (symlinkat, from, fd, to);
+}
+weak_alias (__symlinkat, symlinkat)
