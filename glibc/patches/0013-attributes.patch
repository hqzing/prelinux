diff --git a/sysdeps/unix/sysv/linux/fchownat.c b/sysdeps/unix/sysv/linux/fchownat.c
new file mode 100644
index 00000000..5314f8e9
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/fchownat.c
@@ -0,0 +1,14 @@
+/* Change ownership of a file, relative to a directory.  PreLinux
+   version: replaces the wrapper generated from syscalls.list, adding
+   path translation and privilege softening .  */
+#include <unistd.h>
+#include <sysdep.h>
+#include <prelinux.h>
+
+int
+fchownat (int fd, const char *file, uid_t owner, gid_t group, int flag)
+{
+  PRELINUX_TRANSLATE (file);
+  return PRELINUX_SOFTEN_PRIV (INLINE_SYSCALL_CALL (fchownat, fd, file,
+						    owner, group, flag));
+}
