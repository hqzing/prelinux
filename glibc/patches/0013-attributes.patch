diff --git a/sysdeps/unix/sysv/linux/fchmod.c b/sysdeps/unix/sysv/linux/fchmod.c
new file mode 100644
index 00000000..a4ddf725
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/fchmod.c
@@ -0,0 +1,14 @@
+/* Change mode of an open file.  PreLinux version: replaces the wrapper
+   generated from sysdeps/unix/syscalls.list, adding the privilege
+   softening (EPERM for non-root euid pretends success).  */
+#include <sys/stat.h>
+#include <unistd.h>
+#include <sysdep.h>
+#include <prelinux.h>
+
+int
+__fchmod (int fd, mode_t mode)
+{
+  return PRELINUX_SOFTEN_PRIV (INLINE_SYSCALL_CALL (fchmod, fd, mode));
+}
+weak_alias (__fchmod, fchmod)
