--- /dev/null	2026-10-18 18:39:40.537000000 +0800
+++ b/sysdeps/unix/sysv/linux/uname.c	2026-10-18 23:10:21.977532163 +0800
@@ -0,0 +1,24 @@
+/* PreLinux uname(2): report sysname "Linux" even when the running
+   kernel says otherwise (the HongMeng kernel reports
+   "HarmonyOS", breaking Autotools/CMake and prebuilt programs that
+   check the OS name).  No-op on a Linux kernel.  Replaces the wrapper
+   generated from sysdeps/unix/syscalls.list.  Without -DPRELINUX this
+   compiles to the same behavior as the generated wrapper.  */
+#include <string.h>
+#include <sys/utsname.h>
+#include <sysdep.h>
+#include <prelinux.h>
+
+int
+__uname (struct utsname *buf)
+{
+  int ret = INLINE_SYSCALL_CALL (uname, buf);
+#ifdef PRELINUX
+  if (ret == 0 && strcmp (buf->sysname, "Linux") != 0)
+    strcpy (buf->sysname, "Linux"); /* field is 65 bytes, plenty */
+#endif
+  return ret;
+}
+weak_alias (__uname, uname)
+libc_hidden_def (__uname)
+libc_hidden_def (uname)
