+	{
+	  /* O_PATH descriptors cannot be fchmod'ed: go through /proc.  */
+	  struct fd_to_filename fdname;
+	  r = __chmod (__fd_to_filename (fd, &fdname), mode);
+	}
+      return PRELINUX_SOFTEN_PRIV (r);
+    }
