+++ b/sysdeps/unix/sysv/linux/aarch64/syscall.S
@@ -28,6 +28,21 @@
 
 ENTRY (syscall)
 	uxtw	x8, w0
+
+	/* The HongMeng kernel answers a policy-blocked syscall with SIGSYS instead of
+	   ENOSYS, which kills the caller.  The numbers below are the ones a
+	   probe on a HarmonyOS PC observed dying that way; return ENOSYS for
+	   them so callers take their normal fallback.  Keep the table sorted
+	   and re-run the probe when the kernel changes.  */
+	adrp	x9, .Lblocked_syscalls
+	add	x9, x9, :lo12:.Lblocked_syscalls
+	mov	w10, #246
+.Lblocked_loop:
+	ldr	w11, [x9], #4
+	cmp	w8, w11
+	b.eq	99f
+	subs	w10, w10, #1
+	b.ne	.Lblocked_loop
 	mov	x0, x1
 	mov	x1, x2
 	mov	x2, x3
@@ -39,6 +54,259 @@
 	cmn	x0, #4095
 	b.cs	1f
 	RET
+99:
+	mov	w0, #-38
 1:
 	b	SYSCALL_ERROR
