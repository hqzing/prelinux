+/* PreLinux: HarmonyOS PC's home filesystem (hmdfs) cannot create hard
+ * links (linkat -> EPERM), and rpm's hard-linked file sets are written
+ * before the payload delivers their content: the first member is opened
+ * and later members are linked to it, while the actual bytes arrive with
+ * whichever member cpio marks as carrying content.  A copy therefore has
+ * to wait until the end of the payload walk — copy at link time and every
+ * additional name would be empty. */
+struct prelinux_copy_link {
+    int sdirfd;
+    char *spath;
+    int ddirfd;
+    char *dpath;
+    struct prelinux_copy_link *next;
+};
+
+static int
+prelinux_copy_at(int sdirfd, const char *spath, int ddirfd, const char *dpath)
+{
+    struct stat st;
+    char buf[65536];
+    ssize_t n;
+    int in = -1, out = -1, rc = 0;
+
+    in = openat(sdirfd, spath, O_RDONLY | O_CLOEXEC);
+    if (in < 0)
+        return -1;
+    if (fstat(in, &st) != 0) {
+        close(in);
+        return -1;
+    }
+    out = openat(ddirfd, dpath, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC,
+                 st.st_mode & 07777);
+    if (out < 0) {
+        close(in);
+        return -1;
+    }
+    while ((n = read(in, buf, sizeof buf)) > 0) {
+        ssize_t off = 0;
+        while (off < n) {
+            ssize_t w = write(out, buf + off, n - off);
+            if (w <= 0) {
+                rc = -1;
+                break;
+            }
+            off += w;
+        }
+        if (rc)
+            break;
+    }
+    if (n < 0)
+        rc = -1;
+    close(in);
+    if (close(out) != 0)
+        rc = -1;
+    return rc;
+}
+
+static void
+prelinux_copy_links(struct prelinux_copy_link **links, int *rc)
+{
+    struct prelinux_copy_link *l = *links;
+
+    while (l) {
+        struct prelinux_copy_link *next = l->next;
+
+        if (!*rc && prelinux_copy_at(l->sdirfd, l->spath,
+                                     l->ddirfd, l->dpath) != 0)
+            *rc = RPMERR_COPY_FAILED;
+        free(l->spath);
+        free(l->dpath);
+        free(l);
+        l = next;
+    }
+    *links = NULL;
+}
+
+static void
+prelinux_copy_links_free(struct prelinux_copy_link **links)
+{
+    struct prelinux_copy_link *l = *links;
+
+    while (l) {
+        struct prelinux_copy_link *next = l->next;
+
+        free(l->spath);
+        free(l->dpath);
+        free(l);
+        l = next;
+    }
+    *links = NULL;
+}
