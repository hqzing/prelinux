 #include <dpkg/db-fsys.h>
 
+/* PreLinux: HarmonyOS PC's home filesystem (hmdfs) is case-insensitive,
+ * so a package shipping two names that differ only in case (the Linux
+ * kernel headers do: xt_CONNMARK.h and xt_connmark.h) keeps just one of
+ * them, and the deferred rename of the other fails with ENOENT because
+ * the .dpkg-new it expected was the same directory entry.  Treat
+ * "source gone but destination present" as that collision: warn and
+ * keep whichever copy landed instead of aborting the transaction. */
+static int
+prelinux_rename_ci(const char *oldname, const char *newname,
+                   const char *dispname)
+{
+	struct stat cist;
+
+	if (rename(oldname, newname) == 0)
+		return 0;
+	if (errno == ENOENT && lstat(newname, &cist) == 0) {
+		warning(_("case-insensitive filesystem: '%.255s' collides with a "
+		          "file differing only in case; keeping the extracted "
+		          "copy"), dispname);
+		return 0;
+	}
+	return -1;
+}
+
 #include "main.h"
 #include "archives.h"
 #include "filters.h"
