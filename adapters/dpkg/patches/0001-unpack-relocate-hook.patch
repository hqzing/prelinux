+/* PreLinux: after a file has been completely written to disk, rewrite
+   ELF PT_INTERP/RPATH and absolute-path shebangs into the instance
+   Done as a subprocess for simplicity and reliability
+   Failures are warnings, never transaction-fatal.
+
+   The tool path comes from $PRELINUX_RELOCATE (env.sh points it at the
+   instance's static binary) because apt sanitizes PATH for dpkg.  */
+void
+prelinux_relocate_path(const char *path)
+{
+	pid_t pid;
+
+	if (getenv("PRELINUX_RELOCATE_DISABLE"))
+		return;
+
+	{
+		const char *tool = getenv("PRELINUX_RELOCATE");
+		if (tool == NULL)
+			tool = "prelinux";
+
+		pid = subproc_fork();
+		if (pid == 0) {
+			execlp(tool, "prelinux", "relocate", "--quiet",
+			       path, NULL);
+			ohshite(_("unable to execute 'prelinux relocate'"));
+		}
+		subproc_reap(pid, "prelinux relocate", SUBPROC_WARN);
+	}
+}
+
+static void
+prelinux_relocate_hook(const char *path)
+{
+	char magic[4];
+	ssize_t n;
+	int fd;
+
+	/* Cheap pre-filter: only ELF files and "#!" scripts qualify. */
+	fd = open(path, O_RDONLY);
+	if (fd < 0)
+		return;
+	n = read(fd, magic, sizeof(magic));
+	close(fd);
+	if (n < 4)
+		return;
+	if (memcmp(magic, "\177ELF", 4) != 0 &&
+	    !(magic[0] == '#' && magic[1] == '!'))
+		return;
+
+	prelinux_relocate_path(path);
+}
+
