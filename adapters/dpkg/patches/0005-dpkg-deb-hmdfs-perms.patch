--- a/src/deb/build.c	2024-09-27 03:14:01.000000000 +0800
+++ b/src/deb/build.c	2026-10-19 20:17:14.551371032 +0800
@@ -217,10 +217,13 @@
     ohshite(_("unable to stat control directory"));
   if (!S_ISDIR(mscriptstab.st_mode))
     ohshit(_("control directory is not a directory"));
+  /* PreLinux: HarmonyOS' hmdfs ignores chmod() and forces the setgid
+     bit on every directory, so the exact-mode check below can never
+     pass there.  Keep the check as a warning: the directory is ours, and
+     the resulting archive's modes are normalized by tar anyway.  */
   if ((mscriptstab.st_mode & 07757) != 0755)
-    ohshit(_("control directory has bad permissions %03lo "
-             "(must be >=0755 and <=0775)"),
-           (unsigned long)(mscriptstab.st_mode & 07777));
+    warning(_("control directory has unusual permissions %03lo "
+              "(hmdfs?)"), (unsigned long)(mscriptstab.st_mode & 07777));
 
   for (mscriptp = maintainerscripts; *mscriptp; mscriptp++) {
     varbuf_reset(&path);
@@ -231,10 +234,11 @@
       if (!S_ISREG(mscriptstab.st_mode))
         ohshit(_("maintainer script '%.50s' is not a plain file or symlink"),
                *mscriptp);
+      /* PreLinux: see above; hmdfs cannot represent 0555.  */
       if ((mscriptstab.st_mode & 07557) != 0555)
-        ohshit(_("maintainer script '%.50s' has bad permissions %03lo "
-                 "(must be >=0555 and <=0775)"),
-               *mscriptp, (unsigned long)(mscriptstab.st_mode & 07777));
+        warning(_("maintainer script '%.50s' has unusual permissions %03lo "
+                  "(hmdfs?)"), *mscriptp,
+                (unsigned long)(mscriptstab.st_mode & 07777));
     } else if (errno != ENOENT) {
       ohshite(_("maintainer script '%.50s' is not stattable"), *mscriptp);
     }
