+/* PreLinux: filesystems without hard-link support (HarmonyOS PC's hmdfs
+ * returns EPERM from link(2)) get an independent copy instead.  The
+ * backup content is identical; only the link count differs. */
+static int
+prelinux_copy_file(const char *src, const char *dst)
+{
+	struct stat st;
+	char buf[65536];
+	ssize_t nr;
+	int in, out;
+
+	if (stat(src, &st) < 0)
+		return -1;
+	in = open(src, O_RDONLY);
+	if (in < 0)
+		return -1;
+	out = open(dst, O_WRONLY | O_CREAT | O_TRUNC, st.st_mode & 07777);
+	if (out < 0) {
+		close(in);
+		return -1;
+	}
+	while ((nr = read(in, buf, sizeof(buf))) > 0) {
+		char *p = buf;
+		ssize_t left = nr;
+
+		while (left > 0) {
+			ssize_t nw = write(out, p, left);
+
+			if (nw < 0) {
+				close(in);
+				close(out);
+				return -1;
+			}
+			p += nw;
+			left -= nw;
+		}
+	}
+	close(in);
+	if (nr < 0 || close(out) < 0)
+		return -1;
+	return 0;
+}
+
+#define PRELINUX_LINK_UNSUPPORTED(e) \
+	((e) == EPERM || (e) == EOPNOTSUPP || (e) == ENOSYS || (e) == EXDEV)
+
